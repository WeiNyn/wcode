{
  "name": "wcode-vscode",
  "displayName": "wcode",
  "description": "wcode chat panel and native diffs — a client of `wcode serve --stdio`",
  "version": "0.0.1",
  "private": true,
  "publisher": "wcode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22.18"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:wcode.start",
    "onCommand:wcode.stop",
    "onCommand:wcode.restart",
    "onCommand:wcode.openDiff"
  ],
  "contributes": {
    "commands": [
      {
        "command": "wcode.start",
        "title": "wcode: Start Session"
      },
      {
        "command": "wcode.stop",
        "title": "wcode: Stop Session"
      },
      {
        "command": "wcode.restart",
        "title": "wcode: Restart"
      },
      {
        "command": "wcode.openDiff",
        "title": "wcode: Open Diff"
      }
    ],
    "configuration": {
      "title": "wcode",
      "properties": {
        "wcode.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `wcode` binary. Empty resolves `wcode` from `PATH`."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.ts",
    "capture": "node scripts/capture.mjs",
    "verify:diff-fixtures": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-diff-fixtures.mjs",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
