{
  "name": "wcode-vscode",
  "displayName": "wcode",
  "description": "wcode team surface: chat panel, native diffs, and a live member sidebar",
  "version": "0.0.1",
  "private": true,
  "publisher": "wcode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22.18"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:wcode.surface",
    "onCommand:wcode.start",
    "onCommand:wcode.stop",
    "onCommand:wcode.restart",
    "onCommand:wcode.openDiff",
    "onCommand:wcode.member.focus",
    "onCommand:wcode.plan.toggle",
    "onCommand:wcode.openInEditor"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wcode",
          "title": "wcode",
          "icon": "media/wcode.svg"
        }
      ]
    },
    "views": {
      "wcode": [
        {
          "id": "wcode.surface",
          "name": "wcode",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "wcode.start",
        "title": "wcode: Start Session"
      },
      {
        "command": "wcode.stop",
        "title": "wcode: Stop Session"
      },
      {
        "command": "wcode.restart",
        "title": "wcode: Restart"
      },
      {
        "command": "wcode.openDiff",
        "title": "wcode: Open Diff"
      },
      {
        "command": "wcode.member.focus",
        "title": "wcode: Focus Member"
      },
      {
        "command": "wcode.member.peek",
        "title": "wcode: Peek Member"
      },
      {
        "command": "wcode.member.ask",
        "title": "wcode: Ask Member"
      },
      {
        "command": "wcode.member.stop",
        "title": "wcode: Stop Member"
      },
      {
        "command": "wcode.plan.toggle",
        "title": "wcode: Toggle Plan Mode"
      },
      {
        "command": "wcode.openInEditor",
        "title": "wcode: Open in Editor"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "wcode.openInEditor",
          "when": "view == wcode.surface",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "wcode",
      "properties": {
        "wcode.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `wcode` binary. Empty resolves `wcode` from `PATH`."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "lint:css": "node scripts/check-css.mjs",
    "test": "node scripts/check-css.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.ts",
    "capture": "node scripts/capture.mjs",
    "verify:diff-fixtures": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-diff-fixtures.mjs",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
