# The repo root's .gitignore only covers /target; this tree is a sibling of the
# Cargo workspace (not swept into it) and needs its own.
node_modules/
out/
*.vsix
*.tsbuildinfo

# Generated by `npm run build` (esbuild) from src/webview/chat.js. The webview
# loads it from disk, so the F5 `preLaunchTask` builds it before the host loads,
# and `vscode:prepublish` builds it before a VSIX is packaged.
media/chat.js
